const EditIcon = { template: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-400 opacity-50"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>' };
const CheckIcon = { template: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><polyline points="20 6 9 17 4 12"/></svg>' };
const PlusIcon = { template: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' };


// --- 1. Editable Field Component ---
const EditableField = {
    props: ['value', 'field', 'itemId', 'onUpdate'],
    setup(props) {
        const isEditing = ref(false);
        const tempValue = ref(props.value);

        const saveValue = () => {
            if (props.value !== tempValue.value) {
                props.onUpdate(props.itemId, props.field, tempValue.value);
            }
            isEditing.value = false;
        };

        const startEditing = () => {
            isEditing.value = true;
            // Ensure tempValue is updated before editing starts
            tempValue.value = props.value; 
            
            // Note: In CodePen, auto-focus might require a nextTick approach
        };

        return {
            isEditing,
            tempValue,
            saveValue,
            startEditing
        };
    },
    template: `
        <span v-if="!isEditing" 
            @click="startEditing" 
            class="cursor-pointer hover:text-sky-300 hover:bg-sky-500/10 px-2 py-1 rounded transition-all flex items-center gap-2 group">
            {{ value }} <span class="opacity-0 group-hover:opacity-100 transition-opacity"><EditIcon /></span>
        </span>
        <div v-else class="flex items-center gap-2 w-full">
            <input 
                type="text" 
                v-model="tempValue" 
                @blur="saveValue"
                @keyup.enter="saveValue"
                autofocus
                class="bg-slate-800 border-b-2 border-sky-500 text-white px-2 py-1 outline-none rounded-t-md w-full min-w-[100px]"
            />
            <button @click.prevent="saveValue"><CheckIcon /></button>
        </div>
    `,
    components: { EditIcon, CheckIcon }
};

// --- 2. Add Person/Service Form Component ---
const AddPersonForm = {
    props: ['onAdd', 'isService', 'nextId'],
    setup(props) {
        const inputData = ref({
            field1: '',
            field2: '',
            field3: '',
        });

        const labels = computed(() => props.isService ? 
            ['نوع الخدمة (المطلوب)', 'اسم الشخص/الشركة', 'الموقع'] :
            ['الاسم (المطلوب)', 'العنوان', 'رقم الهاتف']);

        const handleSubmit = (e) => {
            const { field1, field2, field3 } = inputData.value;

            if (field1 && field2 && field3) {
                let newItem;
                if (props.isService) {
                    newItem = { 
                        id: props.nextId, 
                        type: field1,   
                        name: field2,   
                        loc: field3,    
                        phone: field3 // استخدام نفس الحقل للهاتف مؤقتاً في حالة الخدمات
                    };
                } else {
                    newItem = { 
                        id: props.nextId, 
                        name: field1,   
                        loc: field2,    
                        phone: field3   
                    };
                }
                
                props.onAdd(newItem);
                
                // تفريغ الحقول
                inputData.value = { field1: '', field2: '', field3: '' };
            } else {
                alert('الرجاء إدخال جميع الحقول الثلاثة.');
            }
        };

        return {
            inputData,
            labels,
            handleSubmit,
        };
    },
    template: `
        <form @submit.prevent="handleSubmit" class="glass-card p-4 rounded-xl border-green-500/30 border-dashed border">
            <h5 class="font-bold text-green-400 mb-3 flex items-center gap-2 border-b border-white/5 pb-2">
                <PlusIcon /> إضافة {{ isService ? 'خدمة جديدة' : 'شخص جديد' }}
            </h5>
            <div class="flex flex-col md:flex-row gap-2">
                <input
                    type="text"
                    :placeholder="labels[0]"
                    v-model="inputData.field1"
                    class="bg-slate-800/80 p-2 rounded text-sm w-full outline-none focus:ring-2 focus:ring-green-500 transition-all"
                    dir="rtl"
                />
                <input
                    type="text"
                    :placeholder="labels[1]"
                    v-model="inputData.field2"
                    class="bg-slate-800/80 p-2 rounded text-sm w-full outline-none focus:ring-2 focus:ring-green-500 transition-all"
                    dir="rtl"
                />
                <input
                    type="tel"
                    :placeholder="labels[2]"
                    v-model="inputData.field3"
                    class="bg-slate-800/80 p-2 rounded text-sm w-full outline-none focus:ring-2 focus:ring-green-500 transition-all"
                    dir="ltr"
                />
                <button
                    type="submit"
                    class="bg-green-600 hover:bg-green-500 text-white font-bold p-2 rounded transition-colors flex-shrink-0"
                >
                    إضافة
                </button>
            </div>
        </form>
    `,
    components: { PlusIcon }
};

