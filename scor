                        </h1>
                        <p class="text-slate-400 font-light text-lg tracking-wide">
                            مركز قيادة متكامل للخدمات والتوريدات
                        </p>
                    </div>
                </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                
                <section class="lg:col-span-12 glass-panel rounded-2xl p-6">
                    <h2 class="text-2xl font-bold mb-6 text-sky-300 border-b border-white/10 pb-4 flex items-center gap-2">
                        <span class="bg-sky-500/20 p-2 rounded-lg">⚠️</span> مشاكل وحلول استراتيجية
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div v-for="prob in problems" :key="prob.id" class="glass-card p-5 rounded-xl flex flex-col h-full">
                            <h3 class="font-bold text-lg text-white mb-2">{{ prob.title }}</h3>
                            <div class="flex-grow text-slate-300 text-sm leading-relaxed bg-slate-800/50 p-3 rounded-lg border border-white/5">
                                <strong class="text-emerald-400 block mb-1">الحل المقترح:</strong>
                                {{ prob.solution }}
                            </div>
                        </div>
                    </div>
                </section>

                <section class="lg:col-span-7 flex flex-col gap-6">
                    <div class="glass-panel rounded-2xl p-6 h-full">
                        <h2 class="text-2xl font-bold mb-6 text-sky-300 border-b border-white/10 pb-4 flex items-center gap-2">
                            <span class="bg-sky-500/20 p-2 rounded-lg">📦</span> هرم المورّدين
                        </h2>
                        
                        <div class="mb-6 relative">
                            <h4 class="font-bold text-yellow-400 mb-3 pr-4">1. موريدون متنقلون (القمة)</h4>
                            <div class="space-y-2">
                                <SupplierRow 
                                    v-for="item in tier1" 
                                    :key="item.id" 
                                    :item="item" 
