                                />
                            </div>
                            <div class="mt-4">
                                <AddPersonForm 
                                    :on-add="(newItem) => addItem(tier1, newItem)" 
                                    :next-id="getNextId(tier1)" 
                                />
                            </div>
                        </div>

                        <div class="mb-6 relative">
                            <h4 class="font-bold text-blue-400 mb-3 pr-4">2. فتح حساب مع متجر (الوسط)</h4>
                            <div class="space-y-2">
                                <SupplierRow 
                                    v-for="item in tier2" 
                                    :key="item.id" 
                                    :item="item" 
                                    :on-delete="(id) => deleteItem(tier2, id)"
                                    :on-update="(id, field, value) => updateItem(tier2, id, field, value)"
                                />
                            </div>
                            <div class="mt-4">
                                <AddPersonForm 
                                    :on-add="(newItem) => addItem(tier2, newItem)" 
                                    :next-id="getNextId(tier2)" 
                                />
