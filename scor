// --- 4. Main Dashboard Component (المكون الرئيسي) ---
const Dashboard = {
    setup() {
        // تعريف الحالات الأساسية باستخدام ref
        const problems = ref([
            { id: 1, title: "مشكلة عدم التركيز والانسجام", solution: "تقسيم المهام. زوهير ومصطفى فيكس في الكراج، وأمين يتكلف بـ 'التسخار' خارج الكراج." },
            // ... (بقية المشاكل)
        ]);
        const tier1 = ref([
            { id: 1, name: "مصطفى", loc: "سلا", phone: "067766554" },
            { id: 2, name: "خالد", loc: "سلا", phone: "069888765" },
        ]);
        const tier2 = ref([
            { id: 1, name: "زكريا", loc: "سلا", phone: "0613075900" },
        ]);
        const tier3 = ref([
            { id: 1, name: "موراد", loc: "تابريكت", phone: "0655475153" },
        ]);
        const services = ref([
            { id: 1, type: "إصلاح الفرامل", name: "عبدالرحيم", loc: "روسطال", phone: "0628782927" },
        ]);

        // دالة تحديث عامة
        const updateItem = (listRef, id, field, newValue) => {
            listRef.value = listRef.value.map(item => 
                item.id === id ? { ...item, [field]: newValue } : item
            );
        };

        // دالة حذف عامة
        const deleteItem = (listRef, id) => {
            if (confirm('هل أنت متأكد من الحذف؟')) {
                listRef.value = listRef.value.filter(item => item.id !== id);
            }
        };

        // دالة إضافة عامة
        const addItem = (listRef, newItem) => {
            listRef.value.push(newItem);
        };

        // دالة لحساب الـ ID الجديد
        const getNextId = (listRef) => {
            const maxId = listRef.value.reduce((max, item) => (item.id > max ? item.id : max), 0);
            return maxId + 1;
        };

        return {
            problems,
            tier1,
            tier2,
            tier3,
            services,
            updateItem,
            deleteItem,
            addItem,
            getNextId
        };
    },
    components: { SupplierRow, AddPersonForm, PlusIcon },
    template: `
        <div class="relative w-full max-w-7xl mx-auto p-4 md:p-8">
            <header class="text-center mb-12">
                <div class="inline-block p-1 rounded-2xl bg-gradient-to-r from-sky-400 to-purple-500 mb-6">
                    <div class="bg-slate-900 rounded-xl px-8 py-6 glass-panel">
