                                    <EditableField class="font-bold text-emerald-400 text-sm" 
                                        :value="srv.type" :item-id="srv.id" field="type" :on-update="(id, field, value) => updateItem(services, id, field, value)" />
                                    <button 
                                        @click="deleteItem(services, srv.id)"
